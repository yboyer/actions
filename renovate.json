{
  "extends": ["github>yboyer/renovate-config", "github>yboyer/renovate-config:platformAutomerge"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "uses:\\s*(?<depName>[^\\s@]+)@(?<currentDigest>[a-f0-9]{40})\\s*#\\s*(?<currentValue>v[^\\s]+)",
        "uses:\\s*(?<depName>[^\\s@]+)@(?<currentValue>v[^\\s#]+)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^trivy-scan/action\\.yml$/"
      ],
      "matchStrings": [
        "TRIVY_VERSION:\\s*'(?<currentValue>[^']+)'"
      ],
      "depNameTemplate": "aquasecurity/trivy",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/release\\.yml$/"
      ],
      "matchStrings": [
        "[ \\t](?<depName>conventional-changelog-conventionalcommits)@(?<currentValue>[^\\s\"\\x27]+)"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^semantic-release/action\\.yml$/"
      ],
      "matchStrings": [
        "[ \\t](?<depName>semantic-release|@yboyer/semantic-release-config)@(?<currentValue>[^\\s\"\\x27]+)"
      ],
      "datasourceTemplate": "npm"
    }
  ]
}
